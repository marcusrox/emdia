NODE_ENV=development
PORT=3000
APP_BASE_URL=https://emdia.idevs.com.br

# Usuario local inicial
EMDIA_DEFAULT_PASSWORD=troque-esta-senha
EMDIA_DB_PATH=
EMDIA_BACKUP_DIR=

# Segurança e operação
EMDIA_LOGIN_MAX_ATTEMPTS=5
EMDIA_LOGIN_WINDOW_MS=900000
EMDIA_SESSION_CLEANUP_INTERVAL_MS=3600000
EMDIA_SESSION_CLEANUP_LIMIT=500
EMDIA_REVOKED_SESSION_RETENTION_MS=604800000
EMDIA_READINESS_TIMEOUT_MS=1000
# Habilite somente quando HTTPS estiver garantido até a aplicação.
EMDIA_HTTPS_ENABLED=0

# WhatsApp outbound: mock, evolution-api ou waha
WHATSAPP_PROVIDER=mock

# Evolution API
EVOLUTION_API_BASE_URL=https://evolution.idevsolutions.com.br
EVOLUTION_API_KEY=
EVOLUTION_INSTANCE_NAME=
EVOLUTION_REQUEST_TIMEOUT_MS=15000

# WAHA
WAHA_API_BASE_URL=https://waha.exemplo.com
WAHA_API_KEY=
WAHA_SESSION=
WAHA_REQUEST_TIMEOUT_MS=15000

WHATSAPP_NOTIFICATION_INTERVAL_MS=60000
